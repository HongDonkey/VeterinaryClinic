<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.VeterinaryClinic.Mapper.ReservationMapper">

<resultMap id="reservationMap" type="com.example.VeterinaryClinic.DTO.ReservationDTO">
 		<id property="resvNo" column="RESV_NO"/>
        <result property="name" column="NAME"/>
        <result property="phone" column="PHONE"/>
        <result property="mail" column="MAIL"/>
        <result property="animalType" column="ANMIAL_TYPE"/>
        <result property="animalKind" column="ANIMAL_KIND"/>
        <result property="dept" column="DEPT"/>
        <result property="doctorId" column="DOCTOR_ID"/>
        <result property="title" column="TITLE"/>
        <result property="resvTime" column="RESV_TIME"/>
        <result property="symp" column="SYMP"/>
        <result property="insUser" column="INS_USER"/>
        <result property="insTime" column="INS_TIME"/>
        <result property="modUser" column="MOD_USER"/>
        <result property="modTime" column="MOD_TIME"/>
    </resultMap>

 	<insert id="insertReservation" parameterType="com.example.VeterinaryClinic.DTO.ReservationDTO">
 	<![CDATA[
        INSERT INTO RESERVATION 
        	(RESV_NO, NAME, PHONE, MAIL, ANIMAL_TYPE, ANIMAL_KIND, DEPT, DOCTOR_ID, TITLE, RESV_TIME, SYMP, INS_USER, MOD_USER)
        VALUES (
        #{resvNo},
        #{name},
        #{phone},
        #{mail},
        #{animalType},
        #{animalKind},
        #{dept},
        #{doctorId},
        #{title},
        #{resvTime},
        #{symp},
        #{name},
        #{name}
        )
        ]]> 
    </insert>   
    
    <select id="generateResvNo" resultType="string">
	    SELECT CONCAT(
	            DATE_FORMAT(NOW(), '%Y%m%d'),
	            LPAD(
	                IFNULL(MAX(SUBSTRING(resv_no, 9, 3)), 0) + 1,
	                3,
	                '0'
	            )
	    )
	    FROM reservation
	    WHERE resv_no LIKE CONCAT(DATE_FORMAT(NOW(), '%Y%m%d'), '%')
	</select>

    
</mapper>
