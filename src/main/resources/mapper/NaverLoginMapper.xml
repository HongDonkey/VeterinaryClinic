<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.VeterinaryClinic.Mapper.NaverLoginMapper">

    <!-- 1) ID로 회원 조회 -->
    <select id="getNaverMember" parameterType="string" resultType="com.example.VeterinaryClinic.DTO.MemberDTO">
        SELECT * FROM NAVER_MEMBER WHERE MAIL = #{mail}
    </select>

    <!-- 2) 회원 INSERT -->
    <insert id="insertNaverMember" parameterType="com.example.VeterinaryClinic.DTO.MemberDTO">
         INSERT INTO NAVER_MEMBER (id, name, nickname, mail, phone, ins_user, mod_user)
    	 VALUES (#{id}, #{name}, #{nickname}, #{mail}, #{phone}, #{name}, #{name})
    </insert>

</mapper>
